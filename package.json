{
  "name": "muammar-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @muammar/web dev",
    "dev:api": "pnpm --filter @muammar/api dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @muammar/web build",
    "build:api": "pnpm --filter @muammar/api build",
    "build:worker": "pnpm --filter @muammar/web build:worker",
    "deploy": "pnpm --filter @muammar/web deploy",
    "deploy:api": "pnpm --filter @muammar/api deploy",
    "deploy:all": "pnpm deploy:api && pnpm deploy",
    "lint": "pnpm --filter @muammar/web lint",
    "clean": "rm -rf apps/*/node_modules apps/*/.next apps/*/.open-next node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
